/* =========================================================
   Qubit — clean, responsive design system
   ========================================================= */

:root {
  --bg: #f7f8fc;
  --surface: #ffffff;
  --surface-soft: #f1f3fa;
  --text: #0d1220;
  --muted: #5c6579;
  --border: #e4e8f2;
  --primary: #4f46e5;
  --primary-dark: #4038c9;
  --accent: #06b6d4;
  --dark: #0b1020;
  --radius-sm: 10px;
  --radius: 16px;
  --radius-lg: 24px;
  --shadow-sm: 0 1px 2px rgba(13, 18, 32, 0.04);
  --shadow: 0 12px 32px -12px rgba(13, 18, 32, 0.18);
  --shadow-lg: 0 30px 70px -30px rgba(13, 18, 32, 0.28);
  --max: 1160px;
  --nav-h: 72px;
  --gradient: linear-gradient(120deg, #4f46e5 0%, #7c3aed 50%, #06b6d4 100%);
  --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-display: "Space Grotesk", var(--font-body);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.65;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

body.nav-open {
  overflow: hidden;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
  color: inherit;
}

h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0;
}

p {
  margin: 0;
}

ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

::selection {
  background: rgba(79, 70, 229, 0.18);
}

:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 3px;
  border-radius: 4px;
}

.container {
  width: 100%;
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 24px;
}

/* Background decoration */
.bg-animation {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.bg-animation::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(680px 380px at 12% -5%, rgba(79, 70, 229, 0.1), transparent 70%),
    radial-gradient(620px 360px at 92% 4%, rgba(6, 182, 212, 0.1), transparent 70%);
}

.grid-lines {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, rgba(13, 18, 32, 0.035) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(13, 18, 32, 0.035) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 75%);
}

#particle-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
}

/* =========================================================
   Navigation
   ========================================================= */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: var(--nav-h);
  background: rgba(247, 248, 252, 0.72);
  backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px);
  border-bottom: 1px solid transparent;
  transition: border-color 0.25s ease, background 0.25s ease;
}

.navbar.scrolled {
  background: rgba(255, 255, 255, 0.86);
  border-bottom-color: var(--border);
}

.nav-container {
  max-width: var(--max);
  height: 100%;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.nav-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.logo-mark {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: var(--gradient);
  position: relative;
  box-shadow: 0 6px 16px -6px rgba(79, 70, 229, 0.7);
  flex: none;
}

.logo-mark::after {
  content: "";
  position: absolute;
  inset: 8px;
  border: 2px solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 8px;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  padding: 9px 14px;
  border-radius: 999px;
  font-size: 0.94rem;
  font-weight: 500;
  color: var(--muted);
  transition: color 0.2s ease, background 0.2s ease;
}

.nav-link:hover {
  color: var(--text);
  background: rgba(13, 18, 32, 0.05);
}

.nav-link.active {
  color: var(--primary);
  background: rgba(79, 70, 229, 0.09);
}

.nav-item .nav-cta {
  margin-left: 8px;
  display: inline-flex;
  align-items: center;
  padding: 10px 20px;
  border-radius: 999px;
  background: var(--text);
  color: #fff;
  font-size: 0.92rem;
  font-weight: 600;
  transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.nav-item .nav-cta:hover {
  background: var(--primary);
  color: #fff;
  transform: translateY(-1px);
  box-shadow: 0 10px 24px -12px rgba(79, 70, 229, 0.9);
}

.nav-toggle {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
  cursor: pointer;
  padding: 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 5px;
  transition: border-color 0.2s ease;
}

.nav-toggle:hover {
  border-color: #c9d0e2;
}

.nav-toggle span {
  display: block;
  width: 18px;
  height: 2px;
  border-radius: 2px;
  background: var(--text);
  transition: transform 0.25s ease, opacity 0.2s ease;
}

.nav-toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.nav-toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.nav-toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* =========================================================
   Buttons
   ========================================================= */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 13px 26px;
  border-radius: 999px;
  border: 1px solid transparent;
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  white-space: nowrap;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease,
    border-color 0.2s ease, color 0.2s ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 14px 30px -14px rgba(79, 70, 229, 0.85);
}

.btn-primary:hover {
  background: var(--primary-dark);
  box-shadow: 0 18px 34px -14px rgba(79, 70, 229, 0.9);
}

.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border-color: var(--border);
  box-shadow: var(--shadow-sm);
}

.btn-secondary:hover {
  border-color: #c9d0e2;
  background: #fff;
}

.btn-glass {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
}

.btn-glass:hover {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.45);
}

.btn-large {
  padding: 16px 32px;
  font-size: 1rem;
}

.btn-block {
  width: 100%;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

/* =========================================================
   Typography helpers
   ========================================================= */

.gradient-text {
  background: var(--gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.section {
  padding: clamp(64px, 8vw, 112px) 0;
}

.section-header {
  max-width: 680px;
  margin: 0 auto clamp(36px, 5vw, 56px);
  text-align: center;
}

.section-badge,
.hero-badge,
.page-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 15px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--muted);
  font-size: 0.79rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  box-shadow: var(--shadow-sm);
}

.section-badge {
  margin-bottom: 18px;
}

.badge-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.14);
  flex: none;
}

.section-title {
  font-size: clamp(1.8rem, 3.6vw, 2.7rem);
  font-weight: 700;
}

.section-subtitle {
  margin-top: 16px;
  color: var(--muted);
  font-size: 1.02rem;
}

/* =========================================================
   Hero
   ========================================================= */

.hero {
  position: relative;
  padding: calc(var(--nav-h) + clamp(48px, 8vw, 96px)) 0 clamp(56px, 8vw, 104px);
}

.hero-container {
  width: 100%;
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  align-items: center;
  gap: clamp(32px, 6vw, 72px);
}

.hero-badge {
  margin-bottom: 24px;
  text-transform: none;
  letter-spacing: 0;
  font-size: 0.82rem;
}

.hero-title {
  font-size: clamp(2.2rem, 5.4vw, 3.85rem);
  font-weight: 700;
  letter-spacing: -0.035em;
  max-width: 15ch;
}

.hero-subtitle {
  margin-top: 22px;
  max-width: 50ch;
  color: var(--muted);
  font-size: clamp(1rem, 1.5vw, 1.13rem);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

.hero-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 340px;
}

.quantum-orb {
  position: relative;
  width: min(380px, 78vw);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
}

.orb-core {
  width: 38%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: var(--gradient);
  box-shadow:
    0 0 0 18px rgba(79, 70, 229, 0.06),
    0 0 0 44px rgba(79, 70, 229, 0.035),
    0 26px 60px -20px rgba(79, 70, 229, 0.55);
  animation: pulse 6s ease-in-out infinite;
}

.orb-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1px solid rgba(79, 70, 229, 0.28);
}

.orb-ring-1 {
  transform: rotateX(72deg);
  animation: spin 18s linear infinite;
}

.orb-ring-2 {
  inset: 9%;
  border-color: rgba(6, 182, 212, 0.38);
  transform: rotateY(72deg);
  animation: spin-reverse 22s linear infinite;
}

.orb-ring-3 {
  inset: 19%;
  border-style: dashed;
  border-color: rgba(124, 58, 237, 0.3);
  transform: rotateX(64deg) rotateY(28deg);
  animation: spin 26s linear infinite;
}

@keyframes spin {
  to {
    transform: rotateX(72deg) rotate(360deg);
  }
}

@keyframes spin-reverse {
  to {
    transform: rotateY(72deg) rotate(-360deg);
  }
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
}

/* =========================================================
   Expertise / cards
   ========================================================= */

.expertise-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.expertise-card,
.service-card,
.contact-card,
.contact-form-card,
.process-step {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.expertise-card {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.expertise-card:hover {
  transform: translateY(-4px);
  border-color: #d3d9e8;
  box-shadow: var(--shadow);
}

.expertise-image {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--surface-soft);
}

.expertise-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.expertise-card:hover .expertise-image img {
  transform: scale(1.04);
}

.expertise-content {
  padding: 24px;
}

.expertise-content h3 {
  font-size: 1.08rem;
  font-weight: 600;
  letter-spacing: -0.015em;
}

.expertise-content p {
  margin-top: 10px;
  color: var(--muted);
  font-size: 0.94rem;
}

/* =========================================================
   CTA
   ========================================================= */

.cta-section {
  padding-top: 0;
}

.cta-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--dark);
  color: #fff;
  padding: clamp(36px, 6vw, 72px);
  box-shadow: var(--shadow-lg);
}

.cta-card::before {
  content: "";
  position: absolute;
  inset: -40% -10% auto auto;
  width: 520px;
  height: 520px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(79, 70, 229, 0.55), transparent 65%);
  pointer-events: none;
}

.cta-card::after {
  content: "";
  position: absolute;
  inset: auto auto -50% -15%;
  width: 460px;
  height: 460px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.35), transparent 65%);
  pointer-events: none;
}

.cta-content {
  position: relative;
  z-index: 1;
  max-width: 680px;
}

.cta-content h2 {
  font-size: clamp(1.7rem, 3.4vw, 2.5rem);
  font-weight: 700;
}

.cta-content p {
  margin-top: 14px;
  color: rgba(255, 255, 255, 0.72);
  font-size: 1.02rem;
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.cta-actions .btn-primary {
  background: #fff;
  color: var(--dark);
  box-shadow: none;
}

.cta-actions .btn-primary:hover {
  background: #eef0ff;
}

/* =========================================================
   Page hero (inner pages)
   ========================================================= */

.page-hero {
  padding: calc(var(--nav-h) + clamp(52px, 8vw, 88px)) 0 clamp(32px, 5vw, 56px);
  text-align: center;
}

.page-hero .container {
  max-width: 780px;
}

.page-eyebrow {
  margin-bottom: 20px;
  text-transform: none;
  letter-spacing: 0;
}

.page-hero h1 {
  font-size: clamp(2.1rem, 5vw, 3.4rem);
  font-weight: 700;
  letter-spacing: -0.035em;
}

.page-hero p {
  margin: 20px auto 0;
  max-width: 60ch;
  color: var(--muted);
  font-size: clamp(1rem, 1.4vw, 1.1rem);
}

/* =========================================================
   Services page
   ========================================================= */

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

@media (min-width: 1025px) {
  .services-grid > .service-card:last-child:nth-child(3n + 1) {
    grid-column: 2;
  }
}

.service-card {
  display: flex;
  flex-direction: column;
  padding: 28px;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.service-card:hover {
  transform: translateY(-4px);
  border-color: #d3d9e8;
  box-shadow: var(--shadow);
}

.service-icon {
  width: 46px;
  height: 46px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  background: rgba(79, 70, 229, 0.09);
  color: var(--primary);
  margin-bottom: 20px;
  flex: none;
}

.service-icon svg {
  width: 22px;
  height: 22px;
}

.service-card h3 {
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: -0.015em;
}

.service-card > p {
  margin-top: 10px;
  color: var(--muted);
  font-size: 0.94rem;
}

.service-list {
  display: grid;
  gap: 9px;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.service-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: var(--muted);
  font-size: 0.9rem;
}

.service-list li::before {
  content: "";
  width: 6px;
  height: 6px;
  margin-top: 8px;
  border-radius: 50%;
  background: var(--primary);
  flex: none;
}

/* Process */
.process-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  counter-reset: step;
}

.process-step {
  padding: 26px;
}

.step-number {
  display: inline-grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--text);
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 18px;
}

.process-step h3 {
  font-size: 1rem;
  font-weight: 600;
}

.process-step p {
  margin-top: 8px;
  color: var(--muted);
  font-size: 0.9rem;
}

/* Consultation */
.consultation {
  scroll-margin-top: calc(var(--nav-h) + 24px);
}

.consultation-card {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(28px, 5vw, 56px);
  padding: clamp(28px, 5vw, 56px);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.consultation-info h2 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
}

.consultation-info > p {
  margin-top: 16px;
  color: var(--muted);
}

.consultation-points {
  display: grid;
  gap: 14px;
  margin-top: 26px;
}

.consultation-points li {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  font-size: 0.94rem;
}

.check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(79, 70, 229, 0.1);
  color: var(--primary);
  font-size: 0.7rem;
  font-weight: 700;
  flex: none;
  margin-top: 2px;
}

/* =========================================================
   Forms
   ========================================================= */

.form-grid {
  display: grid;
  gap: 16px;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.form-group {
  display: grid;
  gap: 7px;
}

.form-group label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text);
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg);
  font-size: 0.94rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.form-group textarea {
  min-height: 122px;
  resize: vertical;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #9aa2b6;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  background: #fff;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
}

.form-note {
  margin-top: 12px;
  font-size: 0.8rem;
  color: var(--muted);
}

.form-success {
  display: none;
  margin-top: 14px;
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  border: 1px solid #bbf7d0;
  background: #f0fdf4;
  color: #15803d;
  font-size: 0.9rem;
}

.form-success.show {
  display: block;
}

/* =========================================================
   Contact page
   ========================================================= */

.contact-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(24px, 4vw, 40px);
  align-items: start;
}

.contact-info {
  display: grid;
  gap: 16px;
}

.contact-card {
  padding: 22px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.contact-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: rgba(79, 70, 229, 0.09);
  color: var(--primary);
  flex: none;
}

.contact-icon svg {
  width: 20px;
  height: 20px;
}

.contact-card h3 {
  font-size: 0.98rem;
  font-weight: 600;
}

.contact-card p,
.contact-card a {
  margin-top: 4px;
  color: var(--muted);
  font-size: 0.92rem;
  display: block;
}

.contact-card a:hover {
  color: var(--primary);
}

.contact-form-card {
  padding: clamp(24px, 4vw, 36px);
  box-shadow: var(--shadow);
}

.contact-form-card h2 {
  font-size: 1.4rem;
}

.contact-form-card > p {
  margin: 8px 0 24px;
  color: var(--muted);
  font-size: 0.94rem;
}

/* FAQ */
.faq-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.faq-item {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  padding: 20px 22px;
  box-shadow: var(--shadow-sm);
}

.faq-item summary {
  cursor: pointer;
  font-weight: 600;
  font-size: 0.96rem;
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.faq-item summary::-webkit-details-marker {
  display: none;
}

.faq-item summary::after {
  content: "+";
  font-size: 1.2rem;
  color: var(--muted);
  line-height: 1;
  transition: transform 0.2s ease;
}

.faq-item[open] summary::after {
  transform: rotate(45deg);
}

.faq-item p {
  margin-top: 12px;
  color: var(--muted);
  font-size: 0.92rem;
}

/* =========================================================
   Login
   ========================================================= */

.auth-section {
  padding: calc(var(--nav-h) + clamp(40px, 6vw, 72px)) 0 0;
}

.auth-shell {
  display: grid;
  grid-template-columns: 1fr 1fr;
  max-width: 980px;
  margin: 0 auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.auth-aside {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 580px;
  padding: clamp(30px, 4vw, 48px);
  background: var(--dark);
  color: #fff;
}

.auth-aside-glow {
  position: absolute;
  top: -120px;
  right: -120px;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(79, 70, 229, 0.55), transparent 66%);
  pointer-events: none;
}

.auth-aside-glow::after {
  content: "";
  position: absolute;
  left: -220px;
  top: 380px;
  width: 360px;
  height: 360px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.32), transparent 66%);
}

.auth-brand {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
}

.auth-aside-body {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding-top: 48px;
}

.auth-aside h2 {
  max-width: 16ch;
  font-size: clamp(1.6rem, 2.6vw, 2.15rem);
  font-weight: 700;
  letter-spacing: -0.03em;
}

.auth-aside-body > p {
  margin-top: 14px;
  max-width: 36ch;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.95rem;
}

.auth-points {
  display: grid;
  gap: 12px;
  margin-top: 26px;
}

.auth-points li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  color: rgba(255, 255, 255, 0.86);
  font-size: 0.9rem;
}

.auth-points .check {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  margin-top: 1px;
}

.auth-footnote {
  position: relative;
  z-index: 1;
  margin-top: 36px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.78rem;
}

.auth-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(28px, 4vw, 52px);
}

.auth-head {
  margin-bottom: 26px;
}

.auth-head .section-badge {
  margin-bottom: 16px;
}

.auth-head h1 {
  font-size: clamp(1.6rem, 3vw, 2rem);
  font-weight: 700;
}

.auth-head p {
  margin-top: 8px;
  color: var(--muted);
  font-size: 0.94rem;
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 76px;
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: 8px;
  transform: translateY(-50%);
  padding: 6px 9px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--primary);
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
}

.password-toggle:hover {
  background: rgba(79, 70, 229, 0.08);
}

.auth-options {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 2px 0;
  font-size: 0.87rem;
}

.checkbox {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  cursor: pointer;
  user-select: none;
}

.checkbox input {
  width: 16px;
  height: 16px;
  margin: 0;
  accent-color: var(--primary);
  cursor: pointer;
}

.link {
  color: var(--primary);
  font-weight: 600;
}

.link:hover {
  color: var(--primary-dark);
  text-decoration: underline;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 26px 0 14px;
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--border);
}

.auth-alt {
  text-align: center;
  color: var(--muted);
  font-size: 0.88rem;
}

/* =========================================================
   Footer
   ========================================================= */

.footer {
  margin-top: clamp(48px, 7vw, 88px);
  background: var(--dark);
  color: rgba(255, 255, 255, 0.72);
  padding: clamp(48px, 6vw, 72px) 0 28px;
}

.footer-content {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1.3fr;
  gap: 40px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
}

.footer-description {
  margin-top: 14px;
  max-width: 34ch;
  font-size: 0.92rem;
}

.footer-section h4 {
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.footer-links,
.footer-contact {
  display: grid;
  gap: 10px;
  font-size: 0.92rem;
}

.footer-links a,
.footer-contact a {
  transition: color 0.2s ease;
}

.footer-links a:hover,
.footer-contact a:hover {
  color: #fff;
}

.footer-bottom {
  padding-top: 24px;
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.5);
  display: flex;
  flex-wrap: wrap;
  gap: 8px 24px;
  justify-content: space-between;
}

/* =========================================================
   Reveal animation
   ========================================================= */

.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal.visible {
  opacity: 1;
  transform: none;
}

/* =========================================================
   Responsive
   ========================================================= */

@media (max-width: 1024px) {
  .expertise-grid,
  .services-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .process-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    max-width: 20ch;
  }

  .hero-subtitle {
    max-width: 56ch;
  }

  .hero-visual {
    min-height: 0;
    order: -1;
  }

  .quantum-orb {
    width: min(280px, 62vw);
  }
}

@media (max-width: 900px) {
  .consultation-card,
  .contact-layout {
    grid-template-columns: 1fr;
  }

  .footer-content {
    grid-template-columns: 1fr 1fr;
  }

  .footer-section:first-child {
    grid-column: 1 / -1;
  }

  .faq-grid {
    grid-template-columns: 1fr;
  }

  .auth-shell {
    grid-template-columns: 1fr;
  }

  .auth-aside {
    min-height: 0;
    padding: 32px;
  }

  .auth-aside-body {
    margin-top: 0;
    padding-top: 28px;
  }

  .auth-aside h2 {
    max-width: 22ch;
  }

  .auth-footnote {
    margin-top: 24px;
  }
}

@media (max-width: 860px) {
  .nav-toggle {
    display: flex;
  }

  .nav-menu {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    padding: 16px 24px 24px;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 24px 40px -24px rgba(13, 18, 32, 0.25);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }

  .nav-menu.open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .nav-item {
    width: 100%;
  }

  .nav-link {
    width: 100%;
    padding: 13px 16px;
    border-radius: 12px;
    font-size: 1rem;
  }

  .nav-item .nav-cta {
    margin: 8px 0 0;
    width: 100%;
    justify-content: center;
    padding: 14px 20px;
    border-radius: 12px;
  }
}

@media (max-width: 640px) {
  .container,
  .nav-container,
  .hero-container {
    padding-left: 18px;
    padding-right: 18px;
  }

  .expertise-grid,
  .services-grid,
  .process-grid,
  .form-row {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: calc(var(--nav-h) + 28px);
    padding-bottom: 40px;
  }

  .hero-actions,
  .cta-actions {
    width: 100%;
    flex-direction: column;
  }

  .hero-actions .btn,
  .cta-actions .btn {
    width: 100%;
  }

  .hero-visual {
    display: none;
  }

  .section {
    padding: 56px 0;
  }

  .expertise-content {
    padding: 20px;
  }

  .service-card {
    padding: 24px;
  }

  .auth-section {
    padding-top: calc(var(--nav-h) + 24px);
  }

  .auth-shell {
    border-radius: 20px;
  }

  .auth-aside {
    padding: 24px;
  }

  .auth-aside-body {
    padding-top: 20px;
  }

  .auth-aside-body > p {
    margin-top: 10px;
  }

  .auth-points,
  .auth-footnote {
    display: none;
  }

  .auth-panel {
    padding: 24px;
  }

  .footer-content {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .footer-section:first-child {
    grid-column: auto;
  }

  .footer-bottom {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
